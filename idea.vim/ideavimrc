nmap <leader><enter> <Action>(ShowIntentionActions)
nmap gra <Action>(ShowIntentionActions)
nmap grA <Action>(Refactorings.QuickListPopupAction)
nmap grn <Action>(RenameElement)
nmap grN <Action>(RenameFile)

nmap grF <Action>(ReformatCode)<Action>(OptimizeImports)
nmap grf <Action>(ReformatCode)

